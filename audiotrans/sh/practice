#!/usr/bin/env bash
# Abre un video en mpv para practicar listening: subtítulos ocultos y consulta línea por línea.
set -euo pipefail

lua="$(dirname "$(readlink -f "$0")")/../mpv/audiotrans.lua"
export AUDIOTRANS_DATOS="${AUDIOTRANS_DATOS:-$HOME/.local/share/audiotrans}"
python="${AUDIOTRANS_PYTHON:-python3}"  # lo pasa el punto de entrada (lanzar.py)
cache="$HOME/.cache/audiotrans/sincronizados"
# Súbela cuando cambie lo que producen sincronizar.py o alinear.py, para no usar la caché vieja
version_cache=2
extensiones_video='mp4|mkv|webm|avi|mov|m4v|mpg|mpeg|ts|wmv|flv|ogv'
agentes='claude|gemini|codex|opencode|grok|agy'

ayuda() {
    cat <<'EOF'
Uso: practice <video> [subtítulos.srt] [-<destino>]
     practice --prepare <video o carpeta> [...]
     practice --status [<video o carpeta> ...]
     practice --translate <video o carpeta> [...] [--agent <agente>] [--model <modelo>]
     practice saved

Abre el video en mpv con los subtítulos ocultos. Cuando no entiendas algo:
  r  repetir la línea que acaba de pasar (se pausa al terminarla)
  R  repetirla más lento (0.75×) y con su texto
  e  ir a la línea anterior, si r no cayó en la que querías (cada e, una más)
  E  ir a la línea siguiente
  t  mostrar el texto original de esa línea
  y  mostrar la traducción (la revisada de <video>.<destino>.tsv, si la hay)
  d  guardar la línea como duda, con su audio
  c  seguir viendo con los subtítulos (otra vez c para quitarlos)
  q  quitar la repetición o el texto y seguir viendo normal (para salir: Q)
  v  mostrar u ocultar todos los subtítulos (tecla normal de mpv)
  z / x  adelantar o atrasar los subtítulos 0.1 s (normalmente no hace falta)

Cada serie o película va en su carpeta, con un archivo vacío que dice su
IMDb ID y el par de idiomas: el original y al que se traduce (sin par, en-es):
  touch ~/Videos/white-collar/tt1358522.en-es
  touch ~/Videos/amelie/tt0211915.fr-es
Con temporada y episodio en el nombre (s1-e3, S01E03, t1e3, 1x03) es un episodio de
esa serie; si no, la película.

Sin .srt se usa el que tenga el mismo nombre que el video, y si no existe se
baja de OpenSubtitles en el idioma original (clave en
~/.local/share/audiotrans/opensubtitles, como api_key=<clave>): por el hash
del archivo o, si no hay, por el IMDb ID, comparando hasta 3 versiones con el
audio para quedarse con la que mejor coincide. La primera vez que
se abre un episodio, los subtítulos se sincronizan con el audio por tramos
(~15 s); con --no-sync se usan tal cual.

--prepare ubica además cada línea en el audio palabra por palabra con
Whisper (~6 min de CPU por episodio, con prioridad baja), para que r
repita con el tiempo exacto. Conviene hacerlo antes, cuando no uses la
computadora, p. ej.: practice --prepare ~/Videos/white-collar
Todo se guarda en ~/.cache/audiotrans/sincronizados/. --status dice qué
episodios ya están preparados (sin argumentos, los de la carpeta actual) y
avisa si un .srt tiene palabras pegadas.
Con una carpeta se toman sus videos, y los archivos que no son video se saltan.

La traducción va al idioma de la carpeta; para otro, p. ej. -fr. "practice saved"
lista las dudas guardadas (en ~/.local/share/audiotrans/dudas/).

Los modismos ("Cowboy up") se traducen literal. Un agente o tú pueden escribir la
traducción buena de esas líneas en <video>.<destino>.tsv, junto al video (ver
"python -m audiotrans.traducciones"), e y y d la usan en vez de traducir.
--translate abre un agente con la skill traducir-episodio y el prompt ya escrito
para cada episodio, uno tras otro (al cerrar la conversación sigue el siguiente).
Agentes: claude (el de omisión, o $AUDIOTRANS_AGENTE), gemini, codex, opencode,
grok y agy; --model elige el modelo, con el nombre que use ese agente.
EOF
}

base_de() {
    # Un archivo por combinación de video y .srt (ruta, fecha y tamaño) y versión del código:
    # si cambia cualquiera, se vuelve a procesar
    local clave
    clave="$({ echo "$version_cache"; stat -c '%n %Y %s' "$(readlink -f "$1")" "$(readlink -f "$2")"; } | sha1sum | cut -c1-12)"
    echo "$cache/$(basename "${1%.*}")-$clave"
}

sincronizar() {
    # Escribe <base>.srt sincronizado por tramos si todavía no existe; devuelve 1 si falla
    local video="$1" srt="$2" base="$3"
    [[ -f "$base.srt" ]] && return 0
    mkdir -p "$cache"
    echo "Sincronizando los subtítulos con el audio (~15 s)..."
    if "$python" -m audiotrans.sincronizar "$video" "$srt" "$base.srt.tmp" 2>/dev/null \
        | awk '{v=$3+0; if (NR==1||v<a) a=v; if (NR==1||v>b) b=v} END {printf "  listo: los subtítulos se movieron entre %+.2f y %+.2f s según el tramo\n", a, b}'; then
        mv "$base.srt.tmp" "$base.srt"
    else
        rm -f "$base.srt.tmp"
        return 1
    fi
}

marca_de() {
    # Lee el archivo tt<IMDb ID>[.<original>-<destino>] de la carpeta del video y deja
    # imdb, original y destino_carpeta; sin archivo, imdb queda vacío y el par es en-es
    local dir nombre marcas
    dir="$(cd "$(dirname "$1")" && pwd)"  # la carpeta del enlace, no la del archivo enlazado
    imdb="" original="en" destino_carpeta="es"
    mapfile -t marcas < <(find "$dir" -maxdepth 1 -type f -regextype posix-extended \
        -regex '.*/tt[0-9]+(\.[a-z]{2,3}-[a-z]{2,3})?' -printf '%f\n')
    [[ ${#marcas[@]} -eq 0 ]] && return 0
    if [[ ${#marcas[@]} -gt 1 ]]; then
        echo "practice: hay más de un archivo tt... en $dir: ${marcas[*]}" >&2
        exit 2
    fi
    nombre="${marcas[0]}"
    imdb="${nombre%%.*}"
    if [[ "$nombre" == *.* ]]; then
        original="${nombre#*.}" original="${original%-*}"
        destino_carpeta="${nombre##*-}"
    fi
}

descargar_srt() {
    # Si falta <video>.srt, lo baja de OpenSubtitles en el idioma original; devuelve 1 si no se pudo
    local video="$1" srt="${1%.*}.srt"
    [[ -f "$srt" ]] && return 0
    if [[ -z "$imdb" ]]; then
        echo "practice: para bajar los subtítulos falta el IMDb ID de la serie o película:" >&2
        echo "  touch \"$(cd "$(dirname "$video")" && pwd)/tt<número>.en-es\"" >&2
        echo "  (el número está en la dirección de IMDb, p. ej. imdb.com/title/tt1358522/)" >&2
        return 1
    fi
    echo "Buscando los subtítulos en OpenSubtitles..."
    if "$python" -m audiotrans.subtitulos "$video" "$srt.tmp" "$imdb" "$original"; then
        mv "$srt.tmp" "$srt"
    else
        rm -f "$srt.tmp"
        return 1
    fi
}

videos() {
    # Deja en lista los videos de los argumentos: una carpeta se cambia por sus videos y los
    # archivos que no son video (.srt, tt...) se saltan; lo que no existe se deja para avisar
    local arg
    lista=()
    for arg in "$@"; do
        if [[ -d "$arg" ]]; then
            # Sin argumentos llega ".": se quita el "./" para que los nombres salgan limpios
            mapfile -t -O "${#lista[@]}" lista < <(find "${arg%/}" -maxdepth 1 -type f -regextype posix-extended \
                -iregex ".*\.($extensiones_video)" | sed 's|^\./||' | sort)
        elif [[ ! -e "$arg" ]] || [[ "${arg,,}" =~ \.($extensiones_video)$ ]]; then
            lista+=("$arg")
        fi
    done
}

preparar() {
    local video srt base inicio lista
    videos "$@"
    for video in "${lista[@]}"; do
        srt="${video%.*}.srt"
        echo "== $(basename "$video")"
        [[ -f "$video" ]] || { echo "  no encuentro el video" >&2; continue; }
        marca_de "$video"
        descargar_srt "$video" || { echo "  no encuentro los subtítulos: $srt" >&2; continue; }
        base="$(base_de "$video" "$srt")"
        [[ -f "$base.json" ]] && { echo "  ya estaba preparado"; continue; }
        sincronizar "$video" "$srt" "$base" || { echo "  no se pudo sincronizar" >&2; continue; }
        echo "  ubicando cada línea en el audio con Whisper (~6 min)..."
        inicio=$SECONDS
        if nice -n 19 "$python" -m audiotrans.alinear "$video" "$base.srt" "$base.json.tmp" "$base.exacto.srt.tmp" "$original" 2> >(grep --line-buffered -v -i warn >&2); then
            mv "$base.exacto.srt.tmp" "$base.exacto.srt"
            mv "$base.json.tmp" "$base.json"
            echo "  listo en $(( (SECONDS - inicio) / 60 )) min"
        else
            rm -f "$base.json.tmp" "$base.exacto.srt.tmp"
            echo "  no se pudo alinear" >&2
        fi
    done
}

revisadas_de() {
    # " · N traducciones revisadas" si el video tiene <video>.<destino>.tsv
    local n
    marca_de "$1"
    [[ -f "${1%.*}.$destino_carpeta.tsv" ]] || return 0
    n="$(grep -c '^[0-9]' "${1%.*}.$destino_carpeta.tsv" || true)"
    echo " · $n traducciones revisadas"
}

lanzar_agente() {
    # Abre la sesión interactiva del agente con el prompt inicial; cada uno lo recibe distinto
    local agente="$1" modelo="$2" prompt="$3" m=()
    case "$agente" in
        claude) [[ -z "$modelo" ]] || m=(--model "$modelo"); claude "${m[@]}" "$prompt" ;;
        gemini) [[ -z "$modelo" ]] || m=(-m "$modelo"); gemini "${m[@]}" -i "$prompt" ;;
        codex) [[ -z "$modelo" ]] || m=(-m "$modelo"); codex "${m[@]}" "$prompt" ;;
        opencode) [[ -z "$modelo" ]] || m=(-m "$modelo"); opencode "${m[@]}" --prompt "$prompt" ;;
        grok) [[ -z "$modelo" ]] || m=(-m "$modelo"); grok "${m[@]}" "$prompt" ;;
        agy) [[ -z "$modelo" ]] || m=(--model "$modelo"); agy "${m[@]}" -i "$prompt" ;;
    esac
}

traducir() {
    # Un agente con la skill traducir-episodio por video, uno tras otro: una conversación por
    # episodio sale más barata que todos en una, porque cada llamada reenvía la conversación
    local agente="${AUDIOTRANS_AGENTE:-claude}" modelo="" args=() video srt carpeta prompt lista skills
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent|--model)
                [[ $# -ge 2 ]] || { echo "practice: falta el valor de $1" >&2; exit 2; }
                if [[ "$1" == --agent ]]; then agente="$2"; else modelo="$2"; fi
                shift 2 ;;
            -*) echo "practice: opción desconocida: $1 (ver --help)" >&2; exit 2 ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [[ "$agente" =~ ^($agentes)$ ]] || { echo "practice: agente desconocido: $agente (son ${agentes//|/, })" >&2; exit 2; }
    command -v "$agente" >/dev/null || { echo "practice: no encuentro el comando $agente" >&2; exit 2; }
    # Claude Code, Grok y agy solo leen su carpeta; los demás, ~/.agents/skills (como AGENTES_APARTE
    # en instalar.py, que es quien las enlaza)
    case "$agente" in
        claude) skills=~/.claude/skills ;;
        grok) skills=~/.grok/skills ;;
        agy) skills=~/.gemini/config/skills ;;
        *) skills=~/.agents/skills ;;
    esac
    [[ -f "$skills/traducir-episodio/SKILL.md" ]] \
        || { echo "practice: falta la skill traducir-episodio para $agente (en $skills); instálala con: audiotrans --setup" >&2; exit 2; }
    [[ ${#args[@]} -gt 0 ]] || { ayuda >&2; exit 2; }
    videos "${args[@]}"
    for video in "${lista[@]}"; do
        srt="${video%.*}.srt"
        [[ -f "$video" ]] || { echo "practice: no encuentro el video: $video" >&2; continue; }
        [[ -f "$srt" ]] || { echo "practice: $video no tiene .srt; ábrelo una vez con practice para bajarlo" >&2; continue; }
        carpeta="$(cd "$(dirname "$video")" && pwd)"
        # La ruta completa y las reglas que más tokens ahorran: así el agente no explora
        prompt="Usa la skill traducir-episodio para revisar y corregir las traducciones del episodio completo $carpeta/$(basename "$video"). Síguela al pie de la letra para gastar pocos tokens: no explores, lee la salida de revisar directamente y en cada comando guarda un tramo y pide el siguiente. Al terminar, dame solo el resumen breve."
        echo "== $(basename "$video"): abriendo $agente${modelo:+ ($modelo)}; cuando termine, cierra la conversación para seguir"
        (cd "$carpeta" && lanzar_agente "$agente" "$modelo" "$prompt") || echo "  $agente terminó con error" >&2
        echo "  $(basename "$video")$(revisadas_de "$video")"
    done
}

estado() {
    # Una línea por video: preparado (con el % de líneas ubicadas), solo sincronizado o nada
    local video srt base listos=0 lista
    videos "${@:-.}"
    for video in "${lista[@]}"; do
        srt="${video%.*}.srt"
        if [[ ! -f "$video" ]]; then
            printf '%-14s %s\n' "no existe" "$video"
            continue
        elif [[ ! -f "$srt" ]]; then
            printf '%-14s %s\n' "sin .srt" "$video"
            continue
        fi
        base="$(base_de "$video" "$srt")"
        if [[ -f "$base.json" ]]; then
            listos=$((listos + 1))
            printf '%-14s %s (%s)%s\n' "preparado" "$video" "$("$python" -c '
import json, sys
lineas = json.load(open(sys.argv[1]))["lineas"]
exactas = sum(l["inicio_exacto"] and l["fin_exacto"] for l in lineas)
print(f"{round(100 * exactas / max(len(lineas), 1))} % de las líneas exactas")' "$base.json")" "$(revisadas_de "$video")"
        elif [[ -f "$base.srt" ]]; then
            printf '%-14s %s%s\n' "sincronizado" "$video" "$(revisadas_de "$video")"
        else
            printf '%-14s %s%s\n' "sin preparar" "$video" "$(revisadas_de "$video")"
        fi
        # Un .srt mal hecho (bajado antes de que subtitulos.py lo revisara) estorba al leer y al traducir
        "$python" -c '
import sys
from audiotrans.subtitulos import DEFECTUOSO, defectos_de
d = defectos_de(sys.argv[1])
if d > DEFECTUOSO:
    ruta = sys.argv[1]
    print(" " * 14, f"↳ el .srt tiene {100 * d:.0f} % de líneas con palabras pegadas; para bajar otro: mv {ruta} {ruta}.malo")' "$srt" || true
    done
    echo "$listos de ${#lista[@]} preparados"
}

video="" srt="" destino="" sincronizar=true
case "${1:-}" in
    saved) exec "$python" -m audiotrans.dudas listar ;;
    --prepare) shift; [[ $# -gt 0 ]] || { ayuda >&2; exit 2; }; preparar "$@"; exit 0 ;;
    --status) shift; estado "$@"; exit 0 ;;
    --translate) shift; traducir "$@"; exit 0 ;;
esac
for arg in "$@"; do
    case "$arg" in
        -h|--help) ayuda; exit 0 ;;
        --no-sync) sincronizar=false ;;
        -[a-z][a-z]|-[a-z][a-z][a-z]) destino="${arg#-}" ;;
        -*) echo "practice: opción desconocida: $arg (ver --help)" >&2; exit 2 ;;
        *.srt) srt="$arg" ;;
        *) video="$arg" ;;
    esac
done

[[ -n "$video" ]] || { ayuda >&2; exit 2; }
[[ -f "$video" ]] || { echo "practice: no encuentro el video: $video" >&2; exit 2; }
marca_de "$video"
destino="${destino:-$destino_carpeta}"
[[ -n "$srt" ]] || { descargar_srt "$video" || true; srt="${video%.*}.srt"; }
[[ -f "$srt" ]] || { echo "practice: no encuentro los subtítulos: $srt" >&2; exit 2; }

# Traducciones revisadas (python -m audiotrans.traducciones): y las usa en vez de traducir
traducciones="${video%.*}.$destino.tsv"
[[ -f "$traducciones" ]] || traducciones=""

json=""
if $sincronizar; then
    base="$(base_de "$video" "$srt")"
    if [[ -f "$base.json" ]]; then
        srt="$base.exacto.srt" json="$base.json"  # preparado con --prepare
    elif sincronizar "$video" "$srt" "$base"; then
        srt="$base.srt"
    else
        echo "practice: no se pudo sincronizar; uso el .srt tal cual" >&2
    fi
fi

# Las comas separan opciones en script-opts, así que las rutas no deben tenerlas
for ruta in "$srt" "$json" "$traducciones" "$python"; do
    [[ "$ruta" != *,* ]] || { echo "practice: la ruta no puede tener comas: $ruta" >&2; exit 2; }
done

# Q guarda la posición para retomar, pero no la velocidad (R deja 0.75) ni si se ven los subtítulos
exec mpv --sub-file="$srt" --sub-visibility=no \
    --watch-later-options-remove=speed --watch-later-options-remove=sub-visibility \
    --script="$lua" \
    --script-opts="audiotrans-srt=$(readlink -f "$srt"),audiotrans-json=${json:+$(readlink -f "$json")},audiotrans-traducciones=${traducciones:+$(readlink -f "$traducciones")},audiotrans-python=$python,audiotrans-origen=$original,audiotrans-destino=$destino" \
    "$video"
