#!/usr/bin/env bash
# Abre un video en mpv para practicar listening: subtítulos ocultos y consulta línea por línea.
set -euo pipefail

lib="$(dirname "$(readlink -f "$0")")/../lib"
mpv_dir="$(dirname "$(readlink -f "$0")")/../mpv"
export AUDIOTRANS_DATOS="${AUDIOTRANS_DATOS:-$HOME/.local/share/audiotrans}"
python="$AUDIOTRANS_DATOS/venv/bin/python"

ayuda() {
    cat <<'EOF'
Uso: practicar <video> [subtítulos.srt] [-<destino>]
     practicar dudas

Abre el video en mpv con los subtítulos ocultos. Cuando no entiendas algo:
  r  repetir la línea que acaba de pasar (se pausa al terminarla)
  R  ir a la línea anterior
  t  mostrar el texto original de esa línea
  y  mostrar la traducción
  d  guardar la línea como duda, con su audio
  v  mostrar u ocultar todos los subtítulos (tecla normal de mpv)
  z / x  adelantar o atrasar los subtítulos 0.1 s (normalmente no hace falta)

Sin .srt se usa el que tenga el mismo nombre que el video. La primera vez que
se abre un episodio, los subtítulos se sincronizan con el audio por tramos
(~15 s) y el resultado se guarda en ~/.cache/audiotrans/sincronizados/.
Con --sin-sincronizar se usan tal cual. La traducción va al español; para
otro idioma, p. ej. -fr. "practicar dudas" lista las dudas guardadas
(en ~/.local/share/audiotrans/dudas/).
EOF
}

video="" srt="" destino="es" sincronizar=true
for arg in "$@"; do
    case "$arg" in
        -h|--help) ayuda; exit 0 ;;
        --sin-sincronizar) sincronizar=false ;;
        -[a-z][a-z]|-[a-z][a-z][a-z]) destino="${arg#-}" ;;
        *.srt) srt="$arg" ;;
        *) video="$arg" ;;
    esac
done

if [[ "$video" == "dudas" ]]; then
    exec "$python" "$lib/dudas.py" listar
fi
[[ -n "$video" ]] || { ayuda >&2; exit 2; }
[[ -f "$video" ]] || { echo "practicar: no encuentro el video: $video" >&2; exit 2; }
srt="${srt:-${video%.*}.srt}"
[[ -f "$srt" ]] || { echo "practicar: no encuentro los subtítulos: $srt" >&2; exit 2; }

if $sincronizar; then
    # Un archivo por combinación de video y .srt (ruta y fecha de modificación): si cambia
    # cualquiera de los dos, se vuelve a sincronizar
    cache="$HOME/.cache/audiotrans/sincronizados"
    clave="$(stat -c '%n %Y %s' "$(readlink -f "$video")" "$(readlink -f "$srt")" | sha1sum | cut -c1-12)"
    sincronizado="$cache/$(basename "${video%.*}")-$clave.srt"
    if [[ ! -f "$sincronizado" ]]; then
        mkdir -p "$cache"
        echo "Sincronizando los subtítulos con el audio (solo la primera vez, ~15 s)..."
        "$python" "$lib/sincronizar.py" "$video" "$srt" "$sincronizado.tmp" 2>/dev/null \
            | awk '{v=$3+0; if (NR==1||v<a) a=v; if (NR==1||v>b) b=v} END {printf "  listo: los subtítulos se movieron entre %+.2f y %+.2f s según el tramo\n", a, b}' \
            && mv "$sincronizado.tmp" "$sincronizado" \
            || { rm -f "$sincronizado.tmp"; echo "practicar: no se pudo sincronizar; uso el .srt tal cual" >&2; sincronizado="$srt"; }
    fi
    srt="$sincronizado"
fi

# Las comas separan opciones en script-opts, así que las rutas no deben tenerlas
for ruta in "$srt" "$lib" "$python"; do
    [[ "$ruta" != *,* ]] || { echo "practicar: la ruta no puede tener comas: $ruta" >&2; exit 2; }
done

exec mpv --sub-file="$srt" --sub-visibility=no \
    --script="$mpv_dir/audiotrans.lua" \
    --script-opts="audiotrans-srt=$(readlink -f "$srt"),audiotrans-python=$python,audiotrans-lib=$(readlink -f "$lib"),audiotrans-textrans=$(readlink -f "$lib/../bin/textrans"),audiotrans-destino=$destino" \
    "$video"
