#!/usr/bin/env bash
# Abre un video en mpv para practicar listening: subtítulos ocultos y consulta línea por línea.
set -euo pipefail

lib="$(dirname "$(readlink -f "$0")")/../lib"
mpv_dir="$(dirname "$(readlink -f "$0")")/../mpv"
export AUDIOTRANS_DATOS="${AUDIOTRANS_DATOS:-$HOME/.local/share/audiotrans}"
python="$AUDIOTRANS_DATOS/venv/bin/python"
cache="$HOME/.cache/audiotrans/sincronizados"

ayuda() {
    cat <<'EOF'
Uso: practicar <video> [subtítulos.srt] [-<destino>]
     practicar --preparar <video> [<video> ...]
     practicar --estado <video> [<video> ...]
     practicar dudas

Abre el video en mpv con los subtítulos ocultos. Cuando no entiendas algo:
  r  repetir la línea que acaba de pasar (se pausa al terminarla)
  R  repetirla más lento (0.75×)
  t  mostrar el texto original de esa línea
  y  mostrar la traducción
  d  guardar la línea como duda, con su audio
  v  mostrar u ocultar todos los subtítulos (tecla normal de mpv)
  z / x  adelantar o atrasar los subtítulos 0.1 s (normalmente no hace falta)

Sin .srt se usa el que tenga el mismo nombre que el video, y si no existe se
baja de OpenSubtitles (clave en ~/.local/share/audiotrans/opensubtitles,
como api_key=<clave>) por el hash del archivo o por la serie y el episodio
de la ruta (p. ej. white-collar/s1-e3.mp4); en ese caso compara hasta 3
versiones con el audio y se queda con la que mejor coincide. La primera vez que
se abre un episodio, los subtítulos se sincronizan con el audio por tramos
(~15 s); con --sin-sincronizar se usan tal cual.

--preparar ubica además cada línea en el audio palabra por palabra con
Whisper (~8 min de CPU por episodio, con prioridad baja), para que r
repita con el tiempo exacto. Conviene hacerlo antes, cuando no uses la
computadora, p. ej.: practicar --preparar ~/Videos/white-collar/*.mp4
Todo se guarda en ~/.cache/audiotrans/sincronizados/. --estado dice qué
episodios ya están preparados, p. ej.: practicar --estado ~/Videos/white-collar/*.mp4

La traducción va al español; para otro idioma, p. ej. -fr. "practicar dudas"
lista las dudas guardadas (en ~/.local/share/audiotrans/dudas/).
EOF
}

base_de() {
    # Un archivo por combinación de video y .srt (ruta, fecha y tamaño): si cambia
    # cualquiera de los dos, se vuelve a procesar
    local clave
    clave="$(stat -c '%n %Y %s' "$(readlink -f "$1")" "$(readlink -f "$2")" | sha1sum | cut -c1-12)"
    echo "$cache/$(basename "${1%.*}")-$clave"
}

sincronizar() {
    # Escribe <base>.srt sincronizado por tramos si todavía no existe; devuelve 1 si falla
    local video="$1" srt="$2" base="$3"
    [[ -f "$base.srt" ]] && return 0
    mkdir -p "$cache"
    echo "Sincronizando los subtítulos con el audio (~15 s)..."
    if "$python" "$lib/sincronizar.py" "$video" "$srt" "$base.srt.tmp" 2>/dev/null \
        | awk '{v=$3+0; if (NR==1||v<a) a=v; if (NR==1||v>b) b=v} END {printf "  listo: los subtítulos se movieron entre %+.2f y %+.2f s según el tramo\n", a, b}'; then
        mv "$base.srt.tmp" "$base.srt"
    else
        rm -f "$base.srt.tmp"
        return 1
    fi
}

descargar_srt() {
    # Si falta <video>.srt, lo baja de OpenSubtitles (en inglés); devuelve 1 si no se pudo
    local video="$1" srt="${1%.*}.srt"
    [[ -f "$srt" ]] && return 0
    echo "Buscando los subtítulos en OpenSubtitles..."
    if "$python" "$lib/subtitulos.py" "$video" "$srt.tmp"; then
        mv "$srt.tmp" "$srt"
    else
        rm -f "$srt.tmp"
        return 1
    fi
}

preparar() {
    local video srt base inicio
    for video in "$@"; do
        srt="${video%.*}.srt"
        echo "== $(basename "$video")"
        [[ -f "$video" ]] || { echo "  no encuentro el video" >&2; continue; }
        descargar_srt "$video" || { echo "  no encuentro los subtítulos: $srt" >&2; continue; }
        base="$(base_de "$video" "$srt")"
        [[ -f "$base.json" ]] && { echo "  ya estaba preparado"; continue; }
        sincronizar "$video" "$srt" "$base" || { echo "  no se pudo sincronizar" >&2; continue; }
        echo "  ubicando cada línea en el audio con Whisper (~8 min)..."
        inicio=$SECONDS
        if nice -n 19 "$python" "$lib/alinear.py" "$video" "$base.srt" "$base.json.tmp" "$base.exacto.srt.tmp" 2> >(grep --line-buffered -v -i warn >&2); then
            mv "$base.exacto.srt.tmp" "$base.exacto.srt"
            mv "$base.json.tmp" "$base.json"
            echo "  listo en $(( (SECONDS - inicio) / 60 )) min"
        else
            rm -f "$base.json.tmp" "$base.exacto.srt.tmp"
            echo "  no se pudo alinear" >&2
        fi
    done
}

estado() {
    # Una línea por video: preparado (con el % de líneas ubicadas), solo sincronizado o nada
    local video srt base listos=0
    for video in "$@"; do
        srt="${video%.*}.srt"
        if [[ ! -f "$video" ]]; then
            printf '%-14s %s\n' "no existe" "$video"
            continue
        elif [[ ! -f "$srt" ]]; then
            printf '%-14s %s\n' "sin .srt" "$video"
            continue
        fi
        base="$(base_de "$video" "$srt")"
        if [[ -f "$base.json" ]]; then
            listos=$((listos + 1))
            printf '%-14s %s (%s)\n' "preparado" "$video" "$("$python" -c '
import json, sys
lineas = json.load(open(sys.argv[1]))["lineas"]
exactas = sum(l["inicio_exacto"] and l["fin_exacto"] for l in lineas)
print(f"{round(100 * exactas / max(len(lineas), 1))} % de las líneas exactas")' "$base.json")"
        elif [[ -f "$base.srt" ]]; then
            printf '%-14s %s\n' "sincronizado" "$video"
        else
            printf '%-14s %s\n' "sin preparar" "$video"
        fi
    done
    echo "$listos de $# preparados"
}

video="" srt="" destino="es" sincronizar=true
case "${1:-}" in
    dudas) exec "$python" "$lib/dudas.py" listar ;;
    --preparar) shift; [[ $# -gt 0 ]] || { ayuda >&2; exit 2; }; preparar "$@"; exit 0 ;;
    --estado) shift; [[ $# -gt 0 ]] || { ayuda >&2; exit 2; }; estado "$@"; exit 0 ;;
esac
for arg in "$@"; do
    case "$arg" in
        -h|--help) ayuda; exit 0 ;;
        --sin-sincronizar) sincronizar=false ;;
        -[a-z][a-z]|-[a-z][a-z][a-z]) destino="${arg#-}" ;;
        *.srt) srt="$arg" ;;
        *) video="$arg" ;;
    esac
done

[[ -n "$video" ]] || { ayuda >&2; exit 2; }
[[ -f "$video" ]] || { echo "practicar: no encuentro el video: $video" >&2; exit 2; }
[[ -n "$srt" ]] || { descargar_srt "$video" || true; srt="${video%.*}.srt"; }
[[ -f "$srt" ]] || { echo "practicar: no encuentro los subtítulos: $srt" >&2; exit 2; }

json=""
if $sincronizar; then
    base="$(base_de "$video" "$srt")"
    if [[ -f "$base.json" ]]; then
        srt="$base.exacto.srt" json="$base.json"  # preparado con --preparar
    elif sincronizar "$video" "$srt" "$base"; then
        srt="$base.srt"
    else
        echo "practicar: no se pudo sincronizar; uso el .srt tal cual" >&2
    fi
fi

# Las comas separan opciones en script-opts, así que las rutas no deben tenerlas
for ruta in "$srt" "$json" "$lib" "$python"; do
    [[ "$ruta" != *,* ]] || { echo "practicar: la ruta no puede tener comas: $ruta" >&2; exit 2; }
done

exec mpv --sub-file="$srt" --sub-visibility=no \
    --script="$mpv_dir/audiotrans.lua" \
    --script-opts="audiotrans-srt=$(readlink -f "$srt"),audiotrans-json=${json:+$(readlink -f "$json")},audiotrans-python=$python,audiotrans-lib=$(readlink -f "$lib"),audiotrans-textrans=$(readlink -f "$lib/../bin/textrans"),audiotrans-destino=$destino" \
    "$video"
